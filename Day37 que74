#include<stdio.h>
int main()
{
int a[10][10],i,j,r,c;
printf("enter rows and columns");
scanf("%d%d",&r,&c);
printf("enter matrix element");
for(i=0;i<r;i++)
{
  for(j=0;j<c;j++)
    scanf("%d",&a[i][j]);
}
printf("transpose of matrix");
for(i=0;i<c;i++)
{
  for(j=0;j<r;j++)
    scanf("%d",a[j][i]);
  printf("\n");
}
return 0;
}
